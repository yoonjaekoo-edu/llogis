# Neon PostgreSQL (Vercel 환경변수)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# JWT 시크릿
JWT_SECRET=your-secure-random-secret-here

# NVIDIA NIM API (선택)
NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# 한국투자증권 KIS Open API - 실제 국내주식 현재가 조회
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 로컬 Docker 개발용 (Vercel에서는 무시)
DB_USER=mathuser
DB_HOST=db
DB_NAME=math_solved
DB_PASSWORD=mathpass
DB_PORT=5432

# Cloudflare Turnstile (선택 — 설정 시 회원가입 캡차 활성화)
TURNSTILE_SECRET=your-turnstile-secret-key

# 프론트 Turnstile site key (frontend/.env.local 또는 Vite 환경변수)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
